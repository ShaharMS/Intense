# Optional Compose overrides; merge deliberately, never overwrite an existing .env.
# Optional explicit override; leave unset when using the target helper.
# RIVER_VIEWER_BACKEND=replica-1:8080
RIVER_STABLE_IMAGE=river:stable
RIVER_LTS_IMAGE=river:lts
RIVER_REPLICA_1_IMAGE=river:latest
RIVER_REPLICA_2_IMAGE=river:latest
RIVER_REPLICA_3_IMAGE=river:latest
RIVER_REPLICA_4_IMAGE=river:latest
RIVER_REPLICA_1_PORT=18080
RIVER_STABLE_PORT=18081
RIVER_LTS_PORT=18082
RIVER_REPLICA_2_PORT=18083
RIVER_REPLICA_3_PORT=18084
RIVER_REPLICA_4_PORT=18085
# Per-slot defaults are4CPU/2GiB; matched benchmarks can override a replica:
# RIVER_REPLICA_1_CPUS=16
# RIVER_REPLICA_1_MEMORY=8g
# RIVER_REPLICA_1_OTEL_ENABLED=false
