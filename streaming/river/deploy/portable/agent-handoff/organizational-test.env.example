# FRESH INSTALL / REVIEWED MERGE ONLY. Never replace an existing .env wholesale.
# Existing persisted API settings override these startup fallbacks.
RIVER_PROFILE=auto
RIVER_OPENJPEG_THREADS_PER_DECODE=auto
RIVER_S3_ADAPTIVE_READS=adaptive
# Matched shaped-network lab baseline: SDK,8concurrent operations per source.
# This example is not qualification on the actual organizational service.
RIVER_S3_SERIAL_TRANSPORT=sdk
RIVER_S3_SOURCE_MAX_REQUESTS=8
RIVER_S3_MAX_RETRIES=2
RIVER_TRACE_SOURCE_READS=0
RIVER_S3_PRECINCT_ROI=true
RIVER_S3_MULTIPART_PLT=true
RIVER_S3_MULTIPART_PREFIX=true
RIVER_S3_SINGLE_PREFIX=true
RIVER_S3_EXACT_SUPPORT=true
RIVER_S3_PRECINCT_REBASE=auto
RIVER_GROK_NATIVE=true
RIVER_GROK_PACKED_VIEWS=true
RIVER_OPENHT_COARSE=true
# For fresh installs, leave concurrency/shard/lane overrides empty or unset.
# Do not erase existing explicit overrides silently.
RIVER_S3_RANGE_CONCURRENCY=
RIVER_S3_INDEX_SHARDS=
RIVER_S3_INDEX_LANE_DEPTH=
# Add RUST_LOG via pod env or the example Compose override, not .env alone.
